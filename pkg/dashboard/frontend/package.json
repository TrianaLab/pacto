{
  "name": "pacto-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "gen:sdk": "openapi-typescript src/lib/generated/openapi.json -o src/lib/generated/schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3": "^7.4.3",
    "@types/node": "26.6.6",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-fcose": "^2.2.0",
    "d3": "^7.9.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "openapi-fetch": "0.17.0"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
