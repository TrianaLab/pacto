{
  "name": "pacto-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "gen:sdk": "openapi-typescript src/lib/generated/openapi.json -o src/lib/generated/schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/cytoscape": "^3.21.9",
    "@types/cytoscape-dagre": "^2.3.4",
    "@types/d3": "^7.4.3",
    "@types/node": "22.18.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-expand-collapse": "^4.1.1",
    "cytoscape-fcose": "^2.2.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.5",
    "mermaid": "^11.17.0",
    "openapi-fetch": "0.17.0"
  }
}
