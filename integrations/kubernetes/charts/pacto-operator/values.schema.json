{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "insecureRegistries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watchNamespace": {
          "type": "string"
        },
        "stabilizationWindow": {
          "type": "string"
        },
        "enableProbing": {
          "type": "boolean"
        },
        "enableMetricsObservation": {
          "type": "boolean"
        },
        "kernelEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "staleness": {
              "type": "string"
            },
            "callerIgnoreNamespaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secure": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            }
          }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ociSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "description": "Sign-in for the dashboard: people sign in before it shows anything, every view follows their Kubernetes RBAC and delivery actions run with their own token.",
          "properties": {
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuerURL": { "type": "string" },
                "clientID": { "type": "string" },
                "clientSecretRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "key": { "type": "string" }
                  }
                },
                "redirectURL": { "type": "string" },
                "extraScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "usernameClaim": { "type": "string" },
                "usernamePrefix": { "type": "string" },
                "groupsClaim": { "type": "string" },
                "groupsPrefix": { "type": "string" }
              }
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idleTimeout": { "type": "string", "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
                "maxAge": { "type": "string", "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" }
              }
            },
            "tokenLogin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "deliveryNamespace": { "type": "string" }
          }
        },
        "miraURL": { "type": "string" },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Offline OTLP/JSON trace exports mounted read-only into the dashboard. Not an OTLP receiver and not a trace collector.",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "file"
                ],
                "oneOf": [
                  {
                    "required": [
                      "existingClaim"
                    ]
                  },
                  {
                    "required": [
                      "configMap"
                    ]
                  }
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Stable Data Source identity. Reordering the list keeps every name.",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                    "maxLength": 59
                  },
                  "file": {
                    "type": "string",
                    "description": "Trace file name directly inside this source's mount directory. A single path segment: no directory separator, no whitespace, and no comma (the operator's trace-source flag is comma-delimited).",
                    "minLength": 1,
                    "pattern": "^[^/,\\s]+$",
                    "not": {
                      "pattern": "^\\.\\.?$"
                    }
                  },
                  "existingClaim": {
                    "type": "string",
                    "description": "Existing PVC holding the trace export. A Kubernetes object name (DNS-1123 subdomain).",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                  },
                  "configMap": {
                    "type": "string",
                    "description": "ConfigMap holding a small, static trace export. A Kubernetes object name (DNS-1123 subdomain).",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                  }
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "array"
            }
          }
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "parentRefs": {
              "type": "array"
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array"
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Resource requests and limits for the dashboard container",
          "properties": {
            "limits": {
              "type": "object"
            },
            "requests": {
              "type": "object"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^oci://[^@]+@sha256:[0-9a-f]{64}$"
              }
            },
            "credentialsSecret": {
              "type": "string"
            }
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "array"
            }
          }
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "parentRefs": {
              "type": "array"
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array"
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Resource requests and limits for the Evidence Server container",
          "properties": {
            "limits": {
              "type": "object"
            },
            "requests": {
              "type": "object"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "registry"
            ],
            "properties": {
              "registry": {
                "required": [
                  "subjects"
                ],
                "properties": {
                  "subjects": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": false,
      "description": "The eBPF node agent DaemonSet (runs `pacto agent` from the pacto runtime image) in its own namespace, which the chart creates privileged for Pod Security.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "description": "Dedicated agent namespace (a DNS-1123 label); not the release namespace",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "publishInterval": {
          "type": "string",
          "description": "Go duration, e.g. 30s",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "description": "Resource requests and limits for the node agent container",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "createNamespace": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" }
          }
        },
        "imagePullSecrets": { "type": "array" },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": { "type": "boolean" },
            "annotations": { "type": "object" },
            "name": { "type": "string" }
          }
        },
        "promoter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "poll": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" },
            "workers": { "type": "integer", "minimum": 1 },
            "authFreshness": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" },
            "leaderElect": { "type": "boolean" },
            "upstreamTrust": { "type": "string" },
            "registryCredentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "secretName": { "type": "string" } }
            }
          }
        },
        "recorder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "streamsRepository": { "type": "string" },
            "poll": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" },
            "leaderElect": { "type": "boolean" },
            "serviceAccount": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "create": { "type": "boolean" },
                "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
                "name": { "type": "string" }
              }
            },
            "registryCredentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "secretName": { "type": "string" } }
            },
            "signing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ed25519": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": { "secretName": { "type": "string" }, "key": { "type": "string", "minLength": 1 } }
                },
                "allowOperatorReadableKey": { "type": "boolean" },
                "kms": { "type": "string" },
                "keyless": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "identity": { "type": "string" },
                    "issuer": { "type": "string" },
                    "fulcioURL": { "type": "string" },
                    "timestampURL": { "type": "string" },
                    "trustedRoot": { "type": "string" }
                  }
                }
              }
            },
            "operationTTL": { "type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$" },
            "trust": { "type": "string" },
            "cdeventsSink": { "type": "string" },
            "monitoring": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "enabled": { "type": "boolean" } }
            },
            "extraEnv": { "type": "array" },
            "resources": { "type": "object" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "scrapeTimeout": { "type": "string" }
              }
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "type", "url"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "not": { "pattern": "^pacto[.]" } },
                  "type": { "type": "string", "enum": ["mira", "http", "eval"] },
                  "url": { "type": "string", "pattern": "^https?://[^/]+" },
                  "allowPlainHTTP": { "type": "boolean" },
                  "signers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["name"],
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "publicKey": { "type": "string", "minLength": 1 },
                        "identity": { "type": "string", "minLength": 1 },
                        "issuer": { "type": "string", "minLength": 1 },
                        "trustedRoot": { "type": "string", "minLength": 1 }
                      },
                      "oneOf": [
                        { "required": ["publicKey"], "not": { "anyOf": [{ "required": ["identity"] }, { "required": ["issuer"] }, { "required": ["trustedRoot"] }] } },
                        { "required": ["identity", "issuer", "trustedRoot"], "not": { "required": ["publicKey"] } }
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "if": { "properties": { "url": { "pattern": "^http://", "not": { "pattern": "^http://(localhost|127[.][0-9.]+|\\[::1\\])(:|/|$)" } } } },
                    "then": { "required": ["allowPlainHTTP"], "properties": { "allowPlainHTTP": { "const": true } } }
                  },
                  {
                    "if": { "properties": { "type": { "const": "eval" } } },
                    "then": { "required": ["signers"], "properties": { "signers": { "minItems": 1 } } },
                    "else": { "not": { "required": ["signers"] } }
                  }
                ]
              }
            },
            "caBundle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "configMap": { "type": "string" },
                "key": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agentGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "breakGlassGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "teamGroupPrefix": { "type": "string" },
            "requireOwnerTeam": { "type": "boolean" },
            "humanGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "allowEmptyHumanGroups": { "type": "boolean" }
          }
        },
        "insecureRegistries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "admissionPolicies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowUnguarded": { "type": "boolean" },
            "gitopsUsers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    }
  }
}
