{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "$ref": "#/$defs/imagePullSecrets"
        },
        "commonLabels": {
          "$ref": "#/$defs/stringMap"
        },
        "podSecurityContext": {
          "$ref": "#/$defs/podSecurityContext"
        },
        "securityContext": {
          "$ref": "#/$defs/securityContext"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "imagePullSecrets": {
      "$ref": "#/$defs/imagePullSecrets"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean"
        }
      }
    },
    "insecureRegistries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "serviceAccount": {
      "$ref": "#/$defs/serviceAccount"
    },
    "podAnnotations": {
      "$ref": "#/$defs/stringMap"
    },
    "podLabels": {
      "$ref": "#/$defs/stringMap"
    },
    "podSecurityContext": {
      "$ref": "#/$defs/podSecurityContext"
    },
    "securityContext": {
      "$ref": "#/$defs/securityContext"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watchNamespace": {
          "type": "string"
        },
        "stabilizationWindow": {
          "type": "string"
        },
        "enableProbing": {
          "type": "boolean"
        },
        "enableMetricsObservation": {
          "type": "boolean"
        },
        "kernelEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "staleness": {
              "type": "string"
            },
            "callerIgnoreNamespaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secure": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "serviceMonitor": {
          "$ref": "#/$defs/serviceMonitor"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ociSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "description": "Sign-in for the dashboard: people sign in before it shows anything, every view follows their Kubernetes RBAC and delivery actions run with their own token.",
          "properties": {
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuerURL": {
                  "type": "string"
                },
                "clientID": {
                  "type": "string"
                },
                "clientSecretRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                },
                "redirectURL": { "type": "string" },
                "extraScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "usernameClaim": { "type": "string" },
                "usernamePrefix": { "type": "string" },
                "groupsClaim": { "type": "string" },
                "groupsPrefix": { "type": "string" }
              }
            },
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idleTimeout": { "type": "string", "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" },
                "maxAge": { "type": "string", "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$" }
              }
            },
            "tokenLogin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "required": { "type": "boolean" },
            "deliveryNamespace": { "type": "string" }
          }
        },
        "miraURL": {
          "type": "string"
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Offline OTLP/JSON trace exports mounted read-only into the dashboard. Not an OTLP receiver and not a trace collector.",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "file"
                ],
                "oneOf": [
                  {
                    "required": [
                      "existingClaim"
                    ]
                  },
                  {
                    "required": [
                      "configMap"
                    ]
                  }
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Stable Data Source identity. Reordering the list keeps every name.",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                    "maxLength": 59
                  },
                  "file": {
                    "type": "string",
                    "description": "Trace file name directly inside this source's mount directory. A single path segment: no directory separator, no whitespace, and no comma (the operator's trace-source flag is comma-delimited).",
                    "minLength": 1,
                    "pattern": "^[^/,\\s]+$",
                    "not": {
                      "pattern": "^\\.\\.?$"
                    }
                  },
                  "existingClaim": {
                    "type": "string",
                    "description": "Existing PVC holding the trace export. A Kubernetes object name (DNS-1123 subdomain).",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                  },
                  "configMap": {
                    "type": "string",
                    "description": "ConfigMap holding a small, static trace export. A Kubernetes object name (DNS-1123 subdomain).",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                  }
                }
              }
            }
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "ingress": {
          "$ref": "#/$defs/ingress"
        },
        "httpRoute": {
          "$ref": "#/$defs/httpRoute"
        },
        "resources": {
          "allOf": [
            {
              "$ref": "#/$defs/cpuMemory"
            }
          ],
          "description": "Resource requests and limits for the dashboard container"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^oci://[^@]+@sha256:[0-9a-f]{64}$"
              }
            },
            "credentialsSecret": {
              "type": "string"
            }
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "ingress": {
          "$ref": "#/$defs/ingress"
        },
        "httpRoute": {
          "$ref": "#/$defs/httpRoute"
        },
        "resources": {
          "allOf": [
            {
              "$ref": "#/$defs/cpuMemory"
            }
          ],
          "description": "Resource requests and limits for the Evidence Server container"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "registry"
            ],
            "properties": {
              "registry": {
                "required": [
                  "subjects"
                ],
                "properties": {
                  "subjects": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": false,
      "description": "The eBPF node agent DaemonSet (runs `pacto agent` from the pacto runtime image) in its own namespace, which the chart creates privileged for Pod Security.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "description": "Dedicated agent namespace (a DNS-1123 label); not the release namespace",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "publishInterval": {
          "type": "string",
          "description": "Go duration, e.g. 30s",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
        },
        "resources": {
          "allOf": [
            {
              "$ref": "#/$defs/cpuMemory"
            }
          ],
          "description": "Resource requests and limits for the node agent container"
        }
      }
    },
    "nodeSelector": {
      "$ref": "#/$defs/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "createNamespace": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "imagePullSecrets": {
          "$ref": "#/$defs/imagePullSecrets"
        },
        "serviceAccount": {
          "$ref": "#/$defs/serviceAccount"
        },
        "promoter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "poll": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            },
            "resync": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            },
            "workers": {
              "type": "integer",
              "minimum": 1
            },
            "authFreshness": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            },
            "leaderElect": {
              "type": "boolean"
            },
            "upstreamTrust": {
              "type": "string"
            },
            "registryCredentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string"
                }
              }
            }
          }
        },
        "recorder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "streamsRepository": {
              "type": "string"
            },
            "poll": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            },
            "leaderElect": {
              "type": "boolean"
            },
            "serviceAccount": {
              "$ref": "#/$defs/serviceAccount"
            },
            "registryCredentials": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string"
                }
              }
            },
            "signing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ed25519": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "secretName": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "allowOperatorReadableKey": {
                  "type": "boolean"
                },
                "kms": {
                  "type": "string"
                },
                "keyless": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "identity": {
                      "type": "string"
                    },
                    "issuer": {
                      "type": "string"
                    },
                    "fulcioURL": {
                      "type": "string"
                    },
                    "timestampURL": {
                      "type": "string"
                    },
                    "trustedRoot": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "operationTTL": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
            },
            "trust": {
              "type": "string"
            },
            "cdeventsSink": {
              "type": "string"
            },
            "monitoring": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "extraEnv": {
              "type": "array"
            },
            "resources": {
              "$ref": "#/$defs/resources"
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serviceMonitor": {
              "$ref": "#/$defs/serviceMonitor"
            }
          }
        },
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "type",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9.-]*$",
                    "not": {
                      "pattern": "^pacto[.]"
                    }
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "mira",
                      "http",
                      "eval"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://[^/]+"
                  },
                  "allowPlainHTTP": {
                    "type": "boolean"
                  },
                  "signers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "publicKey": {
                          "type": "string",
                          "minLength": 1
                        },
                        "identity": {
                          "type": "string",
                          "minLength": 1
                        },
                        "issuer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "trustedRoot": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "oneOf": [
                        {
                          "required": [
                            "publicKey"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "identity"
                                ]
                              },
                              {
                                "required": [
                                  "issuer"
                                ]
                              },
                              {
                                "required": [
                                  "trustedRoot"
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "required": [
                            "identity",
                            "issuer",
                            "trustedRoot"
                          ],
                          "not": {
                            "required": [
                              "publicKey"
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "url": {
                          "pattern": "^http://",
                          "not": {
                            "pattern": "^http://(localhost|127[.][0-9.]+|\\[::1\\])(:|/|$)"
                          }
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "allowPlainHTTP"
                      ],
                      "properties": {
                        "allowPlainHTTP": {
                          "const": true
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "eval"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "signers"
                      ],
                      "properties": {
                        "signers": {
                          "minItems": 1
                        }
                      }
                    },
                    "else": {
                      "not": {
                        "required": [
                          "signers"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "caBundle": {
