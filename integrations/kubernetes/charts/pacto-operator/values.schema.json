{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "insecureRegistries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watchNamespace": {
          "type": "string"
        },
        "stabilizationWindow": {
          "type": "string"
        },
        "enableProbing": {
          "type": "boolean"
        },
        "enableMetricsObservation": {
          "type": "boolean"
        },
        "kernelEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "staleness": {
              "type": "string"
            }
          }
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secure": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            }
          }
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ociSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "description": "Sign-in for the dashboard; delivery actions then run with each person's own token.",
          "properties": {
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuerURL": { "type": "string" },
                "clientID": { "type": "string" },
                "clientSecretRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "key": { "type": "string" }
                  }
                },
                "redirectURL": { "type": "string" },
                "extraScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            },
            "teamGroupPrefix": { "type": "string" },
            "agentGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "breakGlassGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "miraURL": { "type": "string" },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Offline OTLP/JSON trace exports mounted read-only into the dashboard. Not an OTLP receiver and not a trace collector.",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "file"
                ],
                "oneOf": [
                  {
                    "required": [
                      "existingClaim"
                    ]
                  },
                  {
                    "required": [
                      "configMap"
                    ]
                  }
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Stable Data Source identity; reordering the list never renames a source.",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                    "maxLength": 59
                  },
                  "file": {
                    "type": "string",
                    "description": "Trace file name directly inside this source's mount directory. A single path segment: no directory separator, no whitespace, and no comma (the operator's trace-source flag is comma-delimited).",
                    "minLength": 1,
                    "pattern": "^[^/,\\s]+$",
                    "not": {
                      "pattern": "^\\.\\.?$"
                    }
                  },
                  "existingClaim": {
                    "type": "string",
                    "description": "Existing PVC holding the trace export. A Kubernetes object name (DNS-1123 subdomain).",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                  },
                  "configMap": {
                    "type": "string",
                    "description": "ConfigMap holding a small, static trace export. A Kubernetes object name (DNS-1123 subdomain).",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                  }
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "array"
            }
          }
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "parentRefs": {
              "type": "array"
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array"
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Resource requests and limits for the dashboard container",
          "properties": {
            "limits": {
              "type": "object"
            },
            "requests": {
              "type": "object"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subjects": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^oci://[^@]+@sha256:[0-9a-f]{64}$"
              }
            },
            "credentialsSecret": {
              "type": "string"
            }
          }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": [
                "string",
                "integer"
              ]
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string"
                        },
                        "pathType": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tls": {
              "type": "array"
            }
          }
        },
        "httpRoute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "parentRefs": {
              "type": "array"
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array"
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Resource requests and limits for the Evidence Server container",
          "properties": {
            "limits": {
              "type": "object"
            },
            "requests": {
              "type": "object"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "registry"
            ],
            "properties": {
              "registry": {
                "required": [
                  "subjects"
                ],
                "properties": {
                  "subjects": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": false,
      "description": "The eBPF node agent DaemonSet (runs `pacto agent` from the pacto runtime image) in its own namespace, which the chart creates privileged for Pod Security.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "description": "Dedicated agent namespace (a DNS-1123 label); not the release namespace",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "publishInterval": {
          "type": "string",
          "description": "Go duration, e.g. 30s",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "description": "Resource requests and limits for the node agent container",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  }
}
