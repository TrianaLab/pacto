{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostgreSQL provisioning request",
  "description": "What a consuming service may ask for when it requests a PostgreSQL database.",
  "type": "object",
  "properties": {
    "size": {
      "type": "string",
      "enum": ["small", "medium", "large"],
      "default": "small",
      "description": "Instance size class."
    },
    "storageGi": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1000,
      "description": "Allocated storage in GiB."
    },
    "highAvailability": {
      "type": "boolean",
      "default": false,
      "description": "Run a standby replica in a second zone."
    },
    "backups": {
      "type": "object",
      "properties": {
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35,
          "description": "How many days of backups to keep."
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["size", "storageGi"],
  "additionalProperties": false
}
