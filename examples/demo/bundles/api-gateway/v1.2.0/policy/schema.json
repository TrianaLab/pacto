{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Gateway Policy",
  "description": "Enforces gateway-specific standards: a public API interface and declared dependencies",
  "type": "object",
  "properties": {
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {
          "type": { "const": "openapi" },
          "visibility": { "const": "public" }
        },
        "required": ["type", "visibility"]
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1
    }
  },
  "required": ["interfaces", "dependencies"]
}
