{
  "openapi": "3.0.3",
  "info": {
    "title": "Shipping rates API",
    "version": "1"
  },
  "paths": {
    "/rates": {
      "get": {
        "operationId": "quoteRate",
        "summary": "Quote a shipping rate",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "carrier": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer"
                    },
                    "currency": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
