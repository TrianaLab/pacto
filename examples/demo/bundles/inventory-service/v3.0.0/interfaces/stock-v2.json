{
  "openapi": "3.0.3",
  "info": {
    "title": "Inventory stock API",
    "version": "2"
  },
  "paths": {
    "/v2/stock/{sku}": {
      "get": {
        "operationId": "getStockV2",
        "summary": "Stock level of one SKU per warehouse",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "available": {
                      "type": "integer"
                    },
                    "warehouse": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/reservations": {
      "post": {
        "operationId": "reserveStock",
        "summary": "Reserve stock for a cart",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reservation_id": {
                      "type": "string"
                    },
                    "expires_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
