{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application settings",
  "type": "object",
  "properties": {
    "LOG_LEVEL": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ],
      "default": "info"
    },
    "FEATURE_FLAGS": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
