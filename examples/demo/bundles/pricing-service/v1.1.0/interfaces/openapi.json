{
  "openapi": "3.0.3",
  "info": {
    "title": "Pricing API",
    "version": "1"
  },
  "paths": {
    "/prices/{sku}": {
      "get": {
        "operationId": "getPrice",
        "summary": "Current price of a SKU",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "integer"
                    },
                    "currency": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
