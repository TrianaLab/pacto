# Built binary (root only; do not ignore the cmd/pacto source directory)
/pacto
# ...and wherever a local GOBIN puts it. `make build` writes to $(GOBIN), which is
# ./bin on some setups, and a 49MB Mach-O once reached a branch that way.
/bin/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Coverage (coverage-<suite>.out: scripts/ci/cover.sh, one per unit suite)
coverage.out
coverage-*.out
coverage.html

# Aval: the pinned binary (.github/aval/install.sh) and each suite's result,
# verify report and run record (.github/aval/run.sh). Aval never hashes it.
.aval/

# Local Go build cache (created when GOCACHE points into the tree)
.gocache/

# MkDocs build output (/site is `make docs-build`; /site-test is the browser gate)
/site/
/site-test/

# Python tooling caches (release/scripts docs generator + checker)
__pycache__/
*.pyc

# Local docs preview build of the WASM demo (CI builds it into site/demo)
/docs/demo/

# TODO
TODO.md

# Config
config.yaml

# Node (Changesets release tooling)
/node_modules/
release/units/*/node_modules/

# Generated bundle artifacts (created by make targets / pacto generate)
pactos/*/interfaces/openapi.json
pactos/*/configuration/schema.json
pactos/*/sbom/
.superpowers/

# Working specs and plans. They are scoped to the work in flight, they go stale
# the moment it lands, and mkdocs already excludes them from the published site
# -- so they are never committed either. Durable design belongs in docs/.
docs/superpowers/

# runtime-regenerated publisher proof transcripts (non-deterministic namespaces)
release/proofs/
.mono-*.workflow.js
.pr-body.md

# repowise deterministic index/cache (built in CI on demand)
.repowise/
/demo
/localregistry
/genbundle
